# Files left out of GitHub's ZIP / tarball downloads (release "Source code"
# archives and "Download ZIP"). The archive keeps what an Arduino user needs:
# library.properties, src/, examples/, keywords.txt, README.md, LICENSE and
# CHANGELOG.md. A git clone still gets everything.

# Development and CI
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.clang-format      export-ignore
/tests              export-ignore
/CMakeLists.txt     export-ignore
/CMakePresets.json  export-ignore

# Documentation site and Doxygen set-up (published to GitHub Pages instead)
/docs               export-ignore
/extras             export-ignore
/Doxyfile           export-ignore
